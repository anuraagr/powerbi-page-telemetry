{
  "name": "PageTelemetryDailyPipeline",
  "properties": {
    "description": "Daily Power BI page-level telemetry collection. Runs the PageTelemetryCollector notebook against the attached PageTelemetry lakehouse and refreshes the silver Delta table.",
    "activities": [
      {
        "name": "RunCollectorNotebook",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 300,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "<paste the notebook GUID after import>",
          "workspaceId": "<paste this pipeline's workspace GUID>",
          "parameters": {
            "COLLECTOR_REF": {
              "value": "main",
              "type": "string"
            }
          }
        }
      }
    ],
    "policy": {
      "elapsedTimeMetric": {}
    },
    "annotations": [
      "page-telemetry",
      "governance",
      "daily"
    ],
    "lastPublishTime": "",
    "concurrency": 1
  },
  "schedule": {
    "name": "DailyAt02UTC",
    "properties": {
      "startDateTime": "2026-01-01T02:00:00Z",
      "endDateTime": "2099-01-01T02:00:00Z",
      "timezone": "UTC",
      "interval": 1,
      "frequency": "Day"
    }
  }
}
