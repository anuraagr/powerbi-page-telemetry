# Sample env file for the systemd service. Copy to /etc/powerbi-page-telemetry/env
# Permissions: chmod 600 /etc/powerbi-page-telemetry/env

PBI_TENANT_ID=00000000-0000-0000-0000-000000000000
PBI_CLIENT_ID=00000000-0000-0000-0000-000000000000
PBI_CLIENT_SECRET=replace-me

PBI_OUTPUT_DIR=/var/lib/powerbi-page-telemetry
PYTHONIOENCODING=utf-8
