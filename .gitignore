# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.python-version

# Collector output (reproducible by `python collector.py --mock`)
etl/out/

# Local IDE / OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Dashboard preview screenshots (regenerated on demand)
dashboard/_preview_*.png
dashboard/architecture_preview.png

# Secrets — should never be committed
.env
*.env
*.pem
*.key

# Themed sample data generated by generate_sample_data.py --theme <name>
# is regenerable from the catalog in the script. Only the default
# healthcare theme (which is the bundled fixture) is committed.
etl/sample_data/generic/
etl/sample_data/financial/
